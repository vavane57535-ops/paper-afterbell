static func add(c: Dictionary) -> void :
	_menu(c)
	_dances(c)

static func _hang() -> Dictionary:
	return M([LR(0.14, -0.96, 0.1), WL(0.0), WR(0.0), {"curl": 0.3, "curl_l": 0.3}])


static func _beats(bpm: float, keys: Array) -> Array:
	var out: Array = []
	for key: Array in keys:
		var copy: Array = key.duplicate()
		copy[0] = float(key[0]) * 60.0 / bpm
		out.append(copy)
	return out



