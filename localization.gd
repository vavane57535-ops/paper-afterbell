static var _name_revision: int = 0
static var _lobby_line: RegEx

static func set_player_names(names: Array) -> void :
	var next: Dictionary = {}
	for value: Variant in names:
		var player_name: String = str(value)
		if not player_name.is_empty() and player_name not in ["Alice", "Ashura", "Usayuko", "Simon", "Lysia", "Elly", "Bleuette"]: next[player_name] = true
	if next != _protected_names:
		_protected_names = next;_name_revision += 1;_memo.clear()

static func breakdown_label(kind: String, locale: String = "") -> String:
	var french: String = str(FRENCH_BREAKDOWN.get(kind, kind))
	return str(TEXT.get(french, french)) if (language if locale.is_empty() else locale) == "en" else french

static func t(source: String) -> String:
	if source.is_empty(): return source
	if FRENCH_BREAKDOWN.has(source): return breakdown_label(source)
	if language != "en": return source
	if _memo.has(source): return str(_memo[source])
	var translated: String = _translate(source, 0, false)
	if _memo.size() > 2048: _memo.clear()
	_memo[source] = translated
	return translated

static func _prepare_patterns() -> void :
	if not _patterns.is_empty(): return
	for description: Dictionary in DISPLAY_TEMPLATES:
		var expression: RegEx = RegEx.new()
		expression.compile(str(description.regex));_patterns.append(expression)
	_lobby_line = RegEx.new()
	_lobby_line.compile("^(.+) · (Ashura|Usayuko|Simon|Lysia|Elly|Bleuette|Alice|Attribué au lancement) · Malice ([0-9]+)( · Hôte)?$")

static func _translate(source: String, depth: int, protect_user: bool) -> String:
	if source.is_empty() or depth > 7: return source
	if protect_user and _protected_names.has(source): return source
	if source.begins_with(" · "): return " · " + _translate(source.substr(3), depth + 1, false)
	var v17: Variant = V17.lookup(source)
	if v17 != null: return str(v17)
	var v16: Variant = V16.lookup(source)
	if v16 != null: return str(v16)
	if V12_TEXT.has(source): return str(V12_TEXT[source])
	if V11_TEXT.has(source): return str(V11_TEXT[source])
	if TEXT.has(source): return str(TEXT[source])
	var aura_suffix: String = " Aura : aide l’équipe ou reste en danger près d’Alice ; 100/100 débloque les bonus de LMS."
	if source.ends_with(aura_suffix): return _translate(source.trim_suffix(aura_suffix), depth + 1, false) + " " + str(V11_TEXT[aura_suffix.strip_edges()])
	var trimmed: String = source.strip_edges()
	if trimmed != source:
		var offset: int = source.find(trimmed)
		return source.substr(0, offset) + _translate(trimmed, depth + 1, protect_user) + source.substr(offset + trimmed.length())
	_prepare_v11_patterns()
	for description: Dictionary in _v11_patterns:
		var found: RegExMatch = (description.pattern as RegEx).search(source)
		if found:
			var output: String = ""
			for chunk: Variant in description.chunks:
				if chunk is int:
					var value: String = found.get_string(int(chunk))
					if int(chunk) in description.translate: value = _translate(value, depth + 1, false)
					output += value
				else: output += str(chunk)
			return output
	_prepare_patterns()

	var lobby_match: RegExMatch = _lobby_line.search(source)
	if lobby_match:
		return lobby_match.get_string(1) + " · " + _translate(lobby_match.get_string(2), depth + 1, false) + " · Malice " + lobby_match.get_string(3) + (" · Host" if not lobby_match.get_string(4).is_empty() else "")
	for i: int in range(_patterns.size()):
		var found: RegExMatch = _patterns[i].search(source)
		if not found: continue
		var description: Dictionary = DISPLAY_TEMPLATES[i]
		var translated: String = ""
		for chunk: Variant in description.chunks:
			if chunk is int:
				var value: String = found.get_string(int(chunk))
				if description.translate.has(int(chunk) - 1): value = _translate(value, depth + 1, false)
				translated += value
			else: translated += str(chunk)
		return translated


	for separator: String in ["\n", "   /   ", " / ", "   ", " · ", " ; "]:
		if not separator in source: continue
		var pieces: PackedStringArray = source.split(separator)
		for i: int in range(pieces.size()): pieces[i] = _translate(pieces[i], depth + 1, true)
		return separator.join(pieces)

	if " : " in source:
		var divider: int = source.find(" : ")
		var heading: String = source.substr(0, divider)
		if V12_TEXT.has(heading) and not _protected_names.has(heading): return str(V12_TEXT[heading]) + ": " + source.substr(divider + 3)
		if V11_TEXT.has(heading) and not _protected_names.has(heading): return str(V11_TEXT[heading]) + ": " + source.substr(divider + 3)
		if TEXT.has(heading) and not _protected_names.has(heading): return str(TEXT[heading]) + ": " + source.substr(divider + 3)
	for marker: String in ["● ", "○ ", "▶  "]:
		if source.begins_with(marker): return marker + _translate(source.substr(marker.length()), depth + 1, false)
	return source

static func _regex_literal(value: String) -> String:
	var result: String = ""
	for character: String in value:
		if character in ["\\", ".", "^", "$", "|", "?", "*", "+", "(", ")", "[", "]", "{", "}"]: result += "\\"
		result += character
	return result

static func _prepare_v11_patterns() -> void :
	if _v11_prepared: return
	_v11_prepared = true
	var tokens: RegEx = RegEx.new();tokens.compile("%[-+0-9.]*[sdf]")


	var ui_captures: Dictionary = {"Nouvelle touche : %s…": [1], "Région : %s  ·  Carte : %s": [2], "%s · %s survivants\nManche %d:%02d · LMS selon la musique": [1], "SALON PRIVÉ  /  %s": [1], "%s · CHARGE": [1], "Cibles : %s": [1]}
	var templates: Dictionary = V11_TEXT.duplicate()
	templates.merge(V12_TEXT, true)
	for source: String in templates:
		var matches: Array[RegExMatch] = tokens.search_all(source)
		if matches.is_empty(): continue
		var translated: String = str(templates[source])
		var destinations: Array[RegExMatch] = tokens.search_all(translated)
		if destinations.size() != matches.size(): continue
		var pattern_text: String = "^"
		var position: int = 0
		for token: RegExMatch in matches:
			pattern_text += _regex_literal(source.substr(position, token.get_start() - position).replace("%%", "%"))
			pattern_text += "([\\s\\S]*?)" if token.get_string().ends_with("s") else "([-+−]?(?:\\d+(?:[.,]\\d+)?|∞))"
			position = token.get_end()
		pattern_text += _regex_literal(source.substr(position).replace("%%", "%")) + "$"
		var expression: RegEx = RegEx.new()
		if expression.compile(pattern_text) != OK: continue
		var chunks: Array = [];position = 0
		for index: int in range(destinations.size()):
			var token: RegExMatch = destinations[index]
			chunks.append(translated.substr(position, token.get_start() - position).replace("%%", "%"));chunks.append(index + 1);position = token.get_end()
		chunks.append(translated.substr(position).replace("%%", "%"))
		_v11_patterns.append({"pattern": expression, "chunks": chunks, "translate": ui_captures.get(source, [])})

static func _property(node: Node, property: String) -> void :
	var current: String = str(node.get(property))
	var key: String = "language_" + property
	var previous: Dictionary = node.get_meta(key, {})
	if current == str(previous.get("rendered", "")) and language == str(previous.get("language", "")) and _name_revision == int(previous.get("names_revision", -1)):
		skipped_properties += 1;return
	var source: String = str(previous.get("source", current)) if current == str(previous.get("rendered", "")) else current

	var keep_name: bool = property == "text" and node is Label and _protected_names.has(source)
	var translated: String = source if keep_name else t(source)
	if current != translated: node.set(property, translated);translated_properties += 1
	node.set_meta(key, {"source": source, "rendered": translated, "language": language, "names_revision": _name_revision})

static func _option_item(node: OptionButton, index: int) -> void :
	var key: String = "language_item_" + str(index)
	var current: String = node.get_item_text(index)
	var old: Dictionary = node.get_meta(key, {})
	if current == str(old.get("rendered", "")) and language == str(old.get("language", "")):
		skipped_properties += 1;return
	var source: String = str(old.get("source", current)) if current == str(old.get("rendered", "")) else current
	var translated: String = t(source)
	if current != translated: node.set_item_text(index, translated);translated_properties += 1
	node.set_meta(key, {"source": source, "rendered": translated, "language": language})

static func apply_tree(node: Node) -> void :
	if not is_instance_valid(node) or bool(node.get_meta("language_user_text", false)): return
	if node is OptionButton:
		for i: int in range(node.item_count): _option_item(node, i)
	elif node is Label or node is Button or node is Label3D or node is RichTextLabel: _property(node, "text")

	if node is LineEdit or node is TextEdit: _property(node, "placeholder_text")
	if node is Control: _property(node, "tooltip_text")
	for child: Node in node.get_children(): apply_tree(child)

static func apply_world_labels(world: Node) -> void :
	if not is_instance_valid(world): return
	var now: int = Time.get_ticks_msec()
	if _world_instance != world.get_instance_id() or now >= _world_scan_after:
		_world_instance = world.get_instance_id();_world_scan_after = now + 2000;_world_labels.clear()
		for label: Node in world.find_children("*", "Label3D", true, false): _world_labels.append(weakref(label))
	for reference: WeakRef in _world_labels:
		var label: Node = reference.get_ref()
		if is_instance_valid(label): _property(label, "text")
