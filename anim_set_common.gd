static func _dizzy(a: float) -> Dictionary:
	var s: float = sin(a)
	var k: float = cos(a)
	var late: float = a - 1.1
	var swing: float = a - 0.7
	return M([
		FL(0.14, 0.06), FR(0.16, -0.3), 
		H(0.24 * s, -0.2 + 0.04 * cos(2.0 * a), -0.12 + 0.24 * k), 
		B(0.03 + 0.3 * k, 0.12 * s, -0.3 * s), 
		C(0.14 * cos(a - 0.5), -0.15 * s, -0.14 * sin(a - 0.5)), 
		HD(-0.45 * cos(late), 0.2 * sin(late), -0.5 * sin(late)), 
		L(0.34 - 0.26 * sin(swing), -0.85, 0.1 + 0.4 * cos(swing)), 
		R(0.34 + 0.26 * sin(swing), -0.85, 0.1 + 0.4 * cos(swing)), 
		{"fp_l": 0.35 * maxf(0.0, - k), "fp_r": -0.5 * maxf(0.0, k), "curl": 0.2, "sq": 1.0, "jaw": 0.35}, 
	])

static func _stunned(c: Dictionary) -> void :




	var loop_time: float = 1.6
	var before: float = - TAU * 0.08 / loop_time
	var keys: Array = [
		[0.0, M([rest(), {"gait": 0.0, "jaw": 0.0}, LR(0.3, -0.8, 0.1), {"curl": 0.3}])], 
		[0.07, M([FL(0.14, 0.06), FR(0.12, -0.2, 0.22), H(0, 0.05, -0.22), B(-0.36), C(-0.3), HD(0.75, 0.0, -0.1), L(0.9, 0.7, 0.2, 0.7), R(0.85, 0.85, 0.1, 0.7), {"fp_l": -0.4, "sq": 1.1, "curl": 0.0, "jaw": 0.9, "fx": "stars sweat"}])], 
		[0.17, M([FR(0.16, -0.48, 0.0), H(0.03, -0.1, -0.42), B(-0.48), C(-0.36), HD(0.65, 0.0, -0.2), L(1.0, 0.55, 0.0, 0.7), R(0.95, 0.62, -0.1, 0.7), {"fp_l": 0.35, "sq": 1.0}]), "s"], 
		[0.31, M([FR(0.16, -0.3), H(0.0, -0.32, -0.05), B(0.42), C(0.25), HD(-0.55, 0.0, 0.25), L(0.45, -0.55, 0.5, 0.2), R(0.4, -0.65, 0.45, 0.2), {"fp_l": 0.0, "sq": 0.9, "jaw": 0.5}])], 
		[0.42, _dizzy(before)], 
	]
	for i: int in range(8):
		var pose: Dictionary = _dizzy(TAU * float(i) / 8.0)
		if i == 4: pose["fx"] = "stars"
		keys.append([0.5 + loop_time * float(i) / 8.0, pose])
	keys.append([0.5 + loop_time - 0.08, _dizzy(before), "l"])
	keys.append([0.5 + loop_time, _dizzy(0.0)])
	c["stunned"] = {"len": 0.5 + loop_time, "loop": true, "loop_from": 0.5, "in": 0.03, "face": "dazed", "keys": keys}





