static func _thumbs(keys: Array, start: float, end: float, step: float, amount: float) -> Array:
	var t: float = start + step * 0.6
	var up: bool = true
	while t < end - step * 0.5:
		keys.append([t, M([WL(amount if up else - amount * 0.6), WR( - amount * 0.8 if up else amount)])])
		up = not up
		t += step
	keys.sort_custom( func(a: Array, b: Array) -> bool: return float(a[0]) < float(b[0]))
	return keys



