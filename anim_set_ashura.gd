static func _pocket_l(flare: float = 0.5) -> Dictionary:
	return Lt(-0.08, -0.8, 0.15, flare)

static func _pocket_r(flare: float = 0.5) -> Dictionary:
	return Rt(-0.08, -0.8, 0.15, flare)

static func _pocket(flare_l: float = 0.5, flare_r: float = 0.5) -> Dictionary:
	return M([_pocket_l(flare_l), _pocket_r(flare_r)])

