static func _merged(a: Array, b: Array) -> Array:
	var keys: Array = a + b
	keys.sort_custom( func(x: Array, y: Array) -> bool: return float(x[0]) < float(y[0]))
	return keys








static func _jump(start: float, top: float, land: float, rise: float, crouch: float, left: Dictionary, right: Dictionary, wide: float = 0.0, squash: float = 0.88, from: float = 0.0) -> Array:
	var closing: Dictionary = {"foot_l": (left.foot_l as Vector3) * 0.35, "foot_r": (right.foot_r as Vector3) * 0.35}
	return [
		[start, M([H(0, - crouch, 0), FLR(from, 0), {"feet": V(0, 0, 0), "fp_l": 0.0, "fp_r": 0.0, "sq": squash}]), "s"], 
		[start + 0.07, M([FLR(from, 0), {"feet": V(0, 0.03, 0), "fp_l": -0.7, "fp_r": -0.7}]), "s"], 
		[start + 0.07, M([H(0, 0.1, 0), {"sq": 1.12}])], 
		[top, M([H(0, rise, 0), left, right, {"feet": V(0, rise, 0), "fp_l": -0.6, "fp_r": -0.6, "sq": 1.03}]), "s"], 
		[land - 0.07, M([H(0, rise * 0.55, 0), closing, {"feet": V(0, rise * 0.45, 0), "fp_l": -0.4, "fp_r": -0.4, "sq": 1.05}]), "l"], 
		[land, M([FLR(wide, 0), {"feet": V(0, 0, 0), "fp_l": 0.0, "fp_r": 0.0}]), "s"], 
		[land, M([H(0, -0.1, 0), {"sq": 0.95}])], 
		[land + 0.07, M([H(0, - crouch * 0.8, 0), {"sq": 0.87}]), "s"], 
	]




static func _pulse(channel: String, from: float, to: float, beats: int, low: Variant, high: Variant) -> Array:
	var keys: Array = []
	for i in range(beats + 1):
		keys.append([lerpf(from, to, float(i) / float(beats)), {channel: (low if i % 2 == 0 else high)}, "l"])
	return keys


